# Fill these in once the book is live, then redeploy.
# Both pages work fine while they are empty.

NEXT_PUBLIC_AMAZON_BOOK_URL=
NEXT_PUBLIC_REVIEW_URL_BOOK1=

# --- Email signup (landing page) ---
# The form action URL from your email provider, and the field name it expects
# for the address. Leave empty and the form still works visually.
#   Kit:        endpoint like https://app.kit.com/forms/XX../subscriptions  | field: email_address
#   Mailchimp:  the form action from the embed code                        | field: EMAIL
#   MailerLite: your embedded form action                                  | field: fields[email]
NEXT_PUBLIC_SIGNUP_ENDPOINT=
NEXT_PUBLIC_SIGNUP_EMAIL_FIELD=
