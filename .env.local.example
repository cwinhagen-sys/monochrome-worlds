# Fill these in once the book is live, then redeploy.
# Both pages work fine while they are empty.

NEXT_PUBLIC_AMAZON_BOOK_URL=
NEXT_PUBLIC_REVIEW_URL_BOOK1=

# --- Email signup (landing page) ---
# Server-side only: no NEXT_PUBLIC_ prefix, so the key never reaches the browser.
#
# MAILERLITE_API_KEY  MailerLite → Integrations → API → generate a token.
# MAILERLITE_GROUP_ID The group the subscriber joins. Point your automation's
#                     "when subscriber joins group" trigger at this group so the
#                     bonus PDF goes out. Find the ID in the group's URL.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Fallback if you'd rather not use an API token: the embedded form's action URL
# (MailerLite → your form → Embed → HTML → copy action="..."). Ignored when
# MAILERLITE_API_KEY is set.
SIGNUP_FORM_ENDPOINT=
